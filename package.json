    "deployment",
    "caddy",
    "reverse-proxy",
    "https",
    "wireguard",
    "tunnel",
    "gateway",
    "cli",
    "llm"
  ],
  "license": "MIT",
  "homepage": "https://github.com/AIcivilization/deepseek-harness-vps#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AIcivilization/deepseek-harness-vps.git"
  },
  "bugs": "https://github.com/AIcivilization/deepseek-harness-vps/issues",
  "bin": {
